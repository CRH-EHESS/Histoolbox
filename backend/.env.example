# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais commiter .env dans le dépôt.

# --- Environnement ----------------------------------------------------------
# docker-compose.yml fixe production par défaut. En production, l'API refuse de
# démarrer si API_KEY est vide ou vaut « changeme ».
HISTOOLBOX_ENV=production

# --- Authentification -------------------------------------------------------
# Clé partagée avec les bêta-testeurs. Doit être longue et aléatoire.
# Générer : openssl rand -hex 32
API_KEY=changeme

# --- CORS -------------------------------------------------------------------
# Origine(s) du frontend autorisées (séparées par des virgules) : schéma, hôte
# et port éventuel, SANS chemin, car un en-tête Origin n'en contient jamais.
# GitHub Pages : https://<username>.github.io (et non …github.io/<repo>)
ALLOWED_ORIGINS=https://username.github.io

# --- Liens dans les emails --------------------------------------------------
# URL publique du frontend, base path compris, sans « / » final. Les emails
# pointent vers <APP_BASE_URL>/ocr/toolbox/<task_id>.
# GitHub Pages : https://<username>.github.io/<repo> (casse exacte du repo)
APP_BASE_URL=https://username.github.io/Histoolbox

# --- Notifications par email (SMTP) -----------------------------------------
# SMTP_HOST vide : aucun email n'est envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse expéditeur (défaut : SMTP_USER)
SMTP_FROM=

# --- Base de données --------------------------------------------------------
# Fichier SQLite partagé par l'API et le worker. Il doit rester dans le volume
# ./data (monté sur /app/data) : ailleurs, chaque conteneur aurait sa propre base.
HISTOOLBOX_DB_PATH=/app/data/tasks.db

# --- Moteur d'inférence vLLM ------------------------------------------------
# URL accessible depuis CE serveur (via VPN si nécessaire).
VLLM_BASE_URL=http://<ip-vpn-vllm>:8000

# --- Nettoyage automatique --------------------------------------------------
# Délai de conservation d'une tâche terminée (completed ou error) après sa
# dernière consultation : 24 h. Les tâches en attente ou en cours ne sont
# jamais supprimées.
CLEANUP_TTL_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=600

# --- Réseau Docker Compose --------------------------------------------------
# Sous-réseau du réseau Compose (défaut : 172.30.0.0/24). L'API ne fait
# confiance à X-Forwarded-For que pour ses IP (Caddy). À décommenter et changer
# s'il chevauche un réseau existant de l'hôte.
# HISTOOLBOX_SUBNET=172.30.0.0/24

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
